HUGHCUBE_ALIFC_ALLOW_FIRE_JOB=On
COMPOSER_PROXY="http://host.docker.internal:7890"

# 网关对外暴露端口（gateway 服务）
APP_EXPOSE_PORT=5012

APP_NAME=Demo
APP_KEY=base64:Ds0v+1R14A7ZBNWD29oSLjUev07IgdV0DLt1fHr4AeA=
APP_URL="http://api.ocula.x4k.net"

APP_ENV=local
APP_DEBUG=true

# log
LOG_LEVEL=debug

# 代理
APP_HTTP_VERIFY=false
#APP_HTTP_PROXY='http://host.docker.internal:8888'

# 队列
QUEUE_CONNECTION="alifc"

# 缓存
CACHE_PREFIX="ocula:v2"

# 阿里云配置
ALIYUN_REGION_ID=""
ALIYUN_ACCOUNT_ID=""
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""

# 函数计算
FC_INTERNAL=false
FC_HTTP_PROXY=${APP_HTTP_PROXY}
FC_REGION_ID=${ALIYUN_REGION_ID}
FC_ACCOUNT_ID=${ALIYUN_ACCOUNT_ID}
FC_ACCESS_KEY_ID=${ALIYUN_ACCESS_KEY_ID}
FC_ACCESS_KEY_SECRET=${ALIYUN_ACCESS_KEY_SECRET}

# database (默认 sqlite，如需切换 pgsql 使用下方配置)
DB_CONNECTION="sqlite"

# database (PostgreSQL — 对应 docker-compose 的 pgsql 服务)
#DB_CONNECTION=pgsql
DB_PGSQL_HOST=pgsql
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=demo_test
DB_PGSQL_USERNAME=demo_test
DB_PGSQL_PASSWORD=demo_test

# redis (对应 docker-compose 的 redis 服务)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# 钉钉
DING_TALK_ROBOT_ENABLED=false

# 性能分析
PROFILER_ENABLE_PROBABILITY=0
