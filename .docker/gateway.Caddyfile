# ==============================================================================
# demo 本地开发反向代理网关
# ==============================================================================
# 作用：
#   - 统一入口（${APP_EXPOSE_PORT:-5012}），后端容器 app:80 不直接暴露
#   - 透传 Host 头，便于业务侧拿到真实域名
#   - 后续如需做 path 分流（例如把部分路径转给 dev 公网），在此文件扩展即可
# ==============================================================================

{
	admin off
	auto_https off
}

:80 {
	log {
		output stdout
		format console
	}

	reverse_proxy app:80 {
		header_up Host {http.request.host}
	}
}
